{
  "name": "kuczewska",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore,storage \"vitest run --config vitest.rules.config.ts\"",
    "test:functions": "npm --prefix functions run test",
    "emulators": "firebase emulators:start --only auth,firestore,storage,functions",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^26.1.1",
    "firebase-tools": "^15.24.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@sanity/client": "^7.14.1",
    "@sanity/image-url": "^2.0.3",
    "firebase": "^12.16.0",
    "swiper": "^12.0.3"
  }
}
